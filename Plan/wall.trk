    title End Wall
    space 300  72 360 144

    room   310 144, 360 144, 360 90

    # stove platform
    color  dark-gray
    obj  360  92, 312 92, 312 144

    # stove
    obj   343 100, 321  97, 317 124, 339 127, 343 100,
    arc  350 124 0 360 4 yellow
    text 325 112 wood
    text 325 107 stove

    # pennisula
    color  light-gray
    obj  360  88, 310 88

    # --------------------------------------
    # trackage
    color orange
    pos  300 142,   0

    thick  1.5
    str   30
    lbl    x

    color  cyan
    curve 28  -90
    lbl    y

    # --------------------------------------
    # constant curve
    mvto   y
    color  orange
    str    4
    lbl    4"

    color  cyan
    curve 28 -50
    lbl    50°

    curve 28 -22
    lbl    72°

