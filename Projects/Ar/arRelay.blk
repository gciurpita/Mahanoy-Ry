    space 340 125 1.5 beige
    font  14

    rect  20  50 30 10 black DccA
    rect  20  20 30 10 black DccB

    rect  70  35 30 40 black Brkr

    rect 320  50 30 10 black X-trk
    rect 320  20 30 10 black Y-trk

    rect 110  95 50 50 black Pwr
    rect 170  65 50 50 black Det
    rect 260  95 50 50 black Processor

    rect 260  35 50 40 black Relay

    moveTo DccA+(15,0)
    lineTo Brkr+(-15,15)    red
    moveTo Brkr+(15,15)
    lineTo Det+(-25,-15)    red
    moveTo Det+(25,-15)     red
    lineTo Relay+(-25,15)   red

    moveTo Relay+(25,15)
    lineTo X-trk+(-15,0)    red

    moveTo DccB+(15,0)
    lineTo Brkr+(-15,-15)   blue
    moveTo Brkr+(15,-15)
    lineTo Relay+(-25,-15)  blue
    moveTo Relay+(25,-15)   blue
    lineTo Y-trk+(-15,0)    blue

#   Det connections    
    moveTo Det+(25,15)
    lineTo +(40,0)          black

#   Coil connections    
    moveTo Relay+(15,20)
    lineTo Processor+(15,-25)  black

    moveTo Relay+(-15,20)
    lineTo Processor+(-15,-25) black

#   Pwr connections    
    moveTo Pwr+(-15,-25)
    lineTo +(0,-20)        red

    moveTo Pwr+(15,-25)
    lineTo +(0,-50)       blue

    moveTo Pwr+(25,15)
    lineTo +(100,0)       black
    moveTo +(-90,5)
    text Vb

    moveTo Det+(0,25)
    lineTo +(0,20)        black

    moveTo Pwr+(0,-25)
    lineTo +(0,-10)       black
    lineTo +(-3,6)        black
    lineTo +(6,0)         black
    lineTo +(-3,-6)       black

    moveTo Det+(0,-25)
    lineTo +(0,-10)       black
    lineTo +(-3,6)        black
    lineTo +(6,0)         black
    lineTo +(-3,-6)       black

    # ground
    moveTo Processor+(0,-25)
    lineTo +(0,-10)       black
    lineTo +(-3,6)        black
    lineTo +(6,0)         black
    lineTo +(-3,-6)       black

    # ground
    moveTo Relay+(0,-20)
    lineTo +(0,-10)       black
    lineTo +(-3,6)        black
    lineTo +(6,0)         black
    lineTo +(-3,-6)       black
