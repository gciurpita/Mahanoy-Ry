    move   1   0
    line   0.5   0
    move   0.2  -0.15
    lbl    cabB6
    
    # ----------------------------
    # sc4
    mvto   B3
    move  -2.5   5
    lbl   _sc3
    rect   1   5 s3

    mvto  _sc3
    move  -3   1.5
    lbl    T2
    move   2   0.25
    line   1   0

    mvto  _sc3
    move  -2.5  0.75
